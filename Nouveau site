<div class="dock" id="dock">
  <p><strong>Audit gratuit</strong><span>Offres dès CHF 79 par mois</span></p>
  <a class="btn btn--sm" href="#audit">Demander<span class="btn__arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></span></a>
