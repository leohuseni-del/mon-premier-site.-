<script>
(function () {
  'use strict';
  var d = document, w = window, root = d.documentElement;
  var $ = function (s, c) { return (c || d).querySelector(s); };
  var $$ = function (s, c) { return Array.prototype.slice.call((c || d).querySelectorAll(s)); };
  var clamp = function (v, a, b) { return v < a ? a : v > b ? b : v; };
  var hasIO = 'IntersectionObserver' in w;
  var calm = w.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var motion = hasIO && !calm;

  /* Exemples par métier (contenu fictif de démonstration) */
  var TRADES = {
    boulangerie: { cat: 'Boulangerie-pâtisserie', ex: 'Boulangerie du Bourg', q: 'boulangerie ouverte dimanche', r1: 'Boulangerie de la Gare', r2: 'Le Fournil du Lac', close: '18 h 30', review: '« La meilleure tresse du quartier, et toujours un mot gentil. »' },
    coiffure: { cat: 'Salon de coiffure', ex: 'Salon Aline', q: 'coiffeur sans rendez-vous', r1: 'Coiffure de la Gare', r2: 'L’Atelier du Lac', close: '18 h 30', review: '« Enfin une coupe qui tient. Et on m’a écoutée. »' },
    garage: { cat: 'Garage automobile', ex: 'Garage des Tilleuls', q: 'garage pneus hiver', r1: 'Garage de la Gare', r2: 'Auto du Lac', close: '18 h', review: '« Pneus changés en une demi-heure. Prix annoncé, prix payé. »' },
    restaurant: { cat: 'Café-restaurant', ex: 'Café de la Poste', q: 'restaurant ouvert ce soir', r1: 'Café de la Gare', r2: 'La Table du Lac', close: '23 h', review: '« Le plat du jour vaut le détour. La terrasse aussi. »' },
    fleuriste: { cat: 'Fleuriste', ex: 'Fleurs du Marché', q: 'fleuriste ouvert maintenant', r1: 'Fleurs de la Gare', r2: 'Le Jardin du Lac', close: '18 h 30', review: '« Un bouquet composé en cinq minutes. Magnifique. »' },
    autre: { cat: 'Entreprise locale', ex: 'Votre entreprise', q: 'près de chez moi, ouvert', r1: 'L’entreprise d’à côté', r2: 'Celle d’en face', close: '18 h', review: '« Sérieux, ponctuels, et un vrai sourire. »' }
  };
  var state = { name: '', trade: 'boulangerie' };

  function toStatic() {              /* filet de sécurité : tout visible, rien d’épinglé */
    root.classList.remove('motion');
    var p = $('.pin'); if (p) { p.classList.remove('is-live'); p.setAttribute('data-step', '6'); }
    var f = $('#pin-fiche'); if (f) f.classList.add('has-photo', 'has-hours', 'has-actions', 'has-reply');
    $$('.shop').forEach(function (s) { if (s.id) s.classList.add('is-lit'); });
  }

  try {
    /* ---------- 1. Votre nom, votre métier ---------- */
    var nameInput = $('#nom'), formName = $('#f-commerce'), typingToken = 0;
    function slug(s) { return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 28); }
    function applyName() {
      var n = state.name.trim(), shown = n || 'Votre commerce';
      $$('[data-name]').forEach(function (el) { el.textContent = n || el.getAttribute('data-fb'); });
      $$('[data-tpl]').forEach(function (el) { el.textContent = n ? el.getAttribute('data-tpl').replace('{n}', function () { return n; }) : el.getAttribute('data-fb'); });
      $$('.shop').forEach(function (s) { s.style.setProperty('--chars', Math.max(10, shown.length)); s.classList.toggle('has-name', !!n); });
      $$('[data-bind="domain"]').forEach(function (el) { el.textContent = (slug(n) || 'votre-commerce') + '.ch'; });
      $$('.js-svgname').forEach(function (t) { t.textContent = shown.toUpperCase(); t.setAttribute('font-size', Math.min(34, 640 / Math.max(10, shown.length)).toFixed(1)); });
    }
    function applyTrade() {
      var t = TRADES[state.trade] || TRADES.boulangerie;
      typingToken++;
      $$('[data-bind]').forEach(function (el) { var k = el.getAttribute('data-bind'); if (t[k] != null) el.textContent = t[k]; });
      $$('.js-trade use').forEach(function (u) { u.setAttribute('href', '#t-' + state.trade); });
      if (nameInput) nameInput.placeholder = t.ex;
    }
    function onName(e) {
      state.name = e.target.value.slice(0, 32);
      if (e.target !== nameInput && nameInput) nameInput.value = state.name;
      if (e.target !== formName && formName) formName.value = state.name;
      applyName();
    }
    if (nameInput) nameInput.addEventListener('input', onName);
    if (formName) formName.addEventListener('input', onName);
    $$('input[name="metier"]').forEach(function (r) { r.addEventListener('change', function () { if (r.checked) { state.trade = r.value; applyTrade(); } }); });

    /* ---------- 2. Formulaire (maquette : non relié) ---------- */
    var form = $('#form'), status = $('#form-status'), offre = $('#f-offre');
    $$('[data-plan]').forEach(function (a) { a.addEventListener('click', function () { if (offre) offre.value = a.getAttribute('data-plan'); }); });
    if (form) form.addEventListener('submit', function (e) {
      e.preventDefault();
      var n = (formName.value || '').trim();
      status.textContent = 'Merci' + (n ? ', ' + n : '') + '. Maquette : ce formulaire n’est pas encore relié. Dans la version finale, votre demande nous parvient directement.';
      status.hidden = false;
    });

    /* ---------- 3. Repères : ton de l’en-tête, chapitre, barre de progression ---------- */
    var chap = $('#chap'), bar = $('.top__bar'), current = null, floodF = 0, docMax = 1;
    var pin = $('.pin');
    function applyTone() {
      if (!current) return;
      var tone = current.getAttribute('data-tone');
      if (current === pin && pin.classList.contains('is-live')) tone = floodF > .6 ? 'jour' : 'nuit';
      if (root.getAttribute('data-tone') !== tone) root.setAttribute('data-tone', tone);
    }
    if (hasIO) {
      var ioChap = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { current = en.target; if (chap) chap.textContent = current.getAttribute('data-chapter'); applyTone(); } });
      }, { rootMargin: '-9% 0px -88% 0px' });
      $$('[data-chapter]').forEach(function (s) { ioChap.observe(s); });

      /* Boucles : en pause hors écran et quand l’onglet est caché */
      var ioLoop = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { en.target.classList.toggle('is-live', en.isIntersecting); });
      }, { rootMargin: '40px' });
      $$('[data-loop]').forEach(function (el) { ioLoop.observe(el); });
      d.addEventListener('visibilitychange', function () { root.classList.toggle('is-hidden', d.hidden); });

      /* Barre d’achat mobile : discrète quand un bouton d’achat est déjà à l’écran */
      var dock = $('#dock'), seen = {};
      var ioDock = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { seen[en.target.id] = en.isIntersecting; });
        dock.classList.toggle('is-off', !!(seen['hero-cta'] || seen.form));
      });
      [$('#hero-cta'), form].forEach(function (el) { if (el) ioDock.observe(el); });
    }

    /* ---------- 4. Mouvement (seulement s’il est permis) ---------- */
    var words = [], wordsEl = $('#words'), lit = 0, wordsNear = false;
    var stage = $('.pin__stage'), pinShop = $('#pin-shop'), fiche = $('#pin-fiche'), cards = $('#pin-cards'), flood = $('#pin-flood'), after = $('#pin-after'), stepEls = $$('.pin__steps li');
    var pinTall = w.matchMedia('(min-height: 520px)'), pinLive = false, pinNear = false, curStep = -1, stepH = 1, scrollable = 1;
    var weekList = $('#week-list'), weekLine = $('#week-line'), weekNear = false;
    var finalShop = $('#final-shop');

    function setStep(s) {
      if (s === curStep) return; curStep = s;
      pin.setAttribute('data-step', s);
      fiche.classList.toggle('has-photo', s >= 1);
      fiche.classList.toggle('has-hours', s >= 2);
      fiche.classList.toggle('has-actions', s >= 3);
      fiche.classList.toggle('has-reply', s >= 4);
      cards.classList.toggle('is-site', s >= 5);
      cards.classList.toggle('is-away', s >= 6);
      pinShop.classList.toggle('is-lit', s >= 6);
      stepEls.forEach(function (li, i) { li.classList.toggle('is-active', i + 1 === s); li.classList.toggle('is-done', i + 1 < s); });
    }
    function updatePin() {
      var y = clamp(-pin.getBoundingClientRect().top, 0, scrollable);
      setStep(Math.min(6, Math.floor(y / stepH + .5)));
      var f = clamp((y - 6.5 * stepH) / (1.4 * stepH), 0, 1);
      if (f !== floodF) {
        floodF = f;
        var e = f * f * (3 - 2 * f);
        flood.style.transform = 'scale(' + (e * 3.7).toFixed(3) + ')';
        after.style.opacity = clamp((f - .5) / .3, 0, 1).toFixed(3);
        applyTone();
      }
    }
    function measure() {
      docMax = Math.max(1, root.scrollHeight - w.innerHeight);
      var live = motion && pinTall.matches;
      if (live !== pinLive) {
        pinLive = live; pin.classList.toggle('is-live', live);
        if (!live) { curStep = -1; setStep(6); flood.style.transform = ''; after.style.opacity = ''; floodF = 0; }
        docMax = Math.max(1, root.scrollHeight - w.innerHeight);
      }
      if (pinLive) {
        scrollable = Math.max(1, pin.offsetHeight - stage.offsetHeight); stepH = scrollable / 7.9;
        var sr = stage.getBoundingClientRect(), r = pinShop.getBoundingClientRect();
        flood.style.left = (r.left - sr.left + r.width * 168 / 520) + 'px';
        flood.style.top = (r.top - sr.top + r.height * 396 / 560) + 'px';
        curStep = -1; updatePin();
      }
      frame();
    }
    function updateWords() {
      var r = wordsEl.getBoundingClientRect(), vh = w.innerHeight, a = vh * .82, b = vh * .4;
      var n = Math.round(clamp((a - r.top) / (r.height + a - b), 0, 1) * words.length), i;
      if (n > lit) for (i = lit; i < n; i++) words[i].classList.add('on');
      else for (i = n; i < lit; i++) words[i].classList.remove('on');
      lit = n;
    }
    function updateWeek() {
      var r = weekList.getBoundingClientRect();
      weekLine.style.transform = 'scaleY(' + clamp((w.innerHeight * .72 - r.top) / r.height, 0, 1).toFixed(4) + ')';
    }
    var ticking = false;
    function frame() {
      ticking = false;
      if (bar) bar.style.transform = 'scaleX(' + clamp(w.scrollY / docMax, 0, 1).toFixed(4) + ')';
      if (pinLive && pinNear) updatePin();
      if (wordsNear) updateWords();
      if (weekNear) updateWeek();
    }
    w.addEventListener('scroll', function () { if (!ticking) { ticking = true; w.requestAnimationFrame(frame); } }, { passive: true });

    if (motion) {
      root.classList.add('motion');

      /* Texte révélé mot par mot */
      (function split(node) {
        Array.prototype.slice.call(node.childNodes).forEach(function (ch) {
          if (ch.nodeType === 3) {
            var frag = d.createDocumentFragment();
            ch.nodeValue.split(/([ \n\t]+)/).forEach(function (part) {
              if (!part) return;
              if (/^[ \n\t]+$/.test(part)) { frag.appendChild(d.createTextNode(' ')); return; }
              var s = d.createElement('span'); s.className = 'w'; s.textContent = part; frag.appendChild(s); words.push(s);
            });
            node.replaceChild(frag, ch);
          } else if (ch.nodeType === 1) split(ch);
        });
      })(wordsEl);

      /* Zones actives : on ne calcule que ce qui est à l’écran */
      var ioNear = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.target === pin) pinNear = en.isIntersecting;
          if (en.target === wordsEl) wordsNear = en.isIntersecting;
          if (en.target === weekList) weekNear = en.isIntersecting;
        });
        frame();
      }, { rootMargin: '20% 0px' });
      [pin, wordsEl, weekList].forEach(function (el) { ioNear.observe(el); });

      /* Apparitions, compteurs, recherche qui se tape, lumière finale */
      function count(el) {
        var to = +el.getAttribute('data-count'), t0 = 0;
        el.textContent = '0';
        w.requestAnimationFrame(function step(t) {
          if (!t0) t0 = t;
          var k = clamp((t - t0) / 1100, 0, 1); k = 1 - Math.pow(1 - k, 3);
          el.textContent = Math.round(to * k);
          if (k < 1) w.requestAnimationFrame(step);
        });
      }
      function typeQuery(el) {
        var full = el.textContent, i = 0, token = ++typingToken;
        el.textContent = '';
        (function tick() {
          if (token !== typingToken) return;
          el.textContent = full.slice(0, ++i);
          if (i < full.length) w.setTimeout(tick, 45 + Math.random() * 55);
        })();
      }
      if (finalShop) finalShop.classList.remove('is-lit');
      var ioOnce = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          var el = en.target; ioOnce.unobserve(el);
          if (el.hasAttribute('data-reveal') || el.id === 'path') el.classList.add('is-in');
          if (el.hasAttribute('data-count')) count(el);
          if (el.classList.contains('serp__q')) typeQuery(el);
          if (el === finalShop) w.setTimeout(function () { finalShop.classList.add('is-lit'); }, 350);
        });
      }, { threshold: .18, rootMargin: '0px 0px -6% 0px' });
      $$('[data-reveal],[data-count],.serp__q,#path,#final-shop').forEach(function (el) { ioOnce.observe(el); });
    }

    applyName(); applyTrade();
    w.addEventListener('resize', measure);
    if (pinTall.addEventListener) pinTall.addEventListener('change', measure);
    if (d.fonts && d.fonts.ready) d.fonts.ready.then(measure);
    w.addEventListener('load', measure);
    measure();
  } catch (err) {
    toStatic();
    if (w.console) console.error(err);
  }
})();
</script>
